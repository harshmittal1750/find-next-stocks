APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# The API reads only from TimescaleDB. DUCKDB_PATH is used by the standalone
# pipeline CLI, not by the dashboard.
DUCKDB_PATH=data/warehouse/find_next_stocks.duckdb
DATABASE_URL=postgresql+asyncpg://findstocks:findstocks@127.0.0.1:5434/findstocks

POSTGRES_DB=findstocks
POSTGRES_USER=findstocks
POSTGRES_PASSWORD=findstocks

# Optional providers. Add credentials only in .env, never in tracked files.
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
UPSTOX_ANALYTICS_TOKEN=
UPSTOX_ACCESS_TOKEN=

# Provider refresh concurrency. Keep these conservative for free APIs.
REFRESH_YAHOO_BATCH_SIZE=25
REFRESH_ALPHA_VANTAGE_BATCH_SIZE=5
