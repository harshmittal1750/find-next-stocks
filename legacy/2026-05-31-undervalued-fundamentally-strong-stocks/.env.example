# Copy this file to ".env" (same folder) and fill in your values.
# .env is gitignored — your key is never committed.
#
# 1. Create a free account at https://resend.com
# 2. Dashboard -> API Keys -> Create API Key (starts with "re_")
# 3. Paste it below. On the free tier you can send FROM onboarding@resend.dev
#    TO the email you signed up with, with no domain setup.

RESEND_API_KEY=re_your_key_here
EMAIL_TO=iamuudit@gmail.com
EMAIL_FROM=Weekly Stock Screen <onboarding@resend.dev>
